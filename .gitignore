# Shared assets are stored once in common/ and copied into each sub-site's
# docs tree by scripts/sync-shared-assets.sh. Ignore the copies so there is
# exactly one editable original.
/sites/*/docs/assets/
/sites/*/docs/stylesheets/
/sites/*/site/

/.idea/
/.bsp/
/project/project/
/project/target/
/target/
/site/
/.ai/
.DS_Store
*.egg-info/
__pycache__/
/task/

tools/.bsp/
tools/.scala-build/

# Claude Code transient files
.claude/*
!.claude/skills/
!.claude/skills/**
